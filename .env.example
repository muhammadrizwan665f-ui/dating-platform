# Database
DATABASE_URL=postgresql://user:password@localhost:5432/dating_platform

# Auth
AUTH_SECRET=            # openssl rand -base64 32
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Object storage (S3-compatible: Cloudflare R2, Backblaze B2, AWS S3, etc.)
STORAGE_URL=
STORAGE_KEY=
STORAGE_SECRET=
STORAGE_BUCKET=
STORAGE_PUBLIC_BASE=

# Realtime chat sidecar
REALTIME_INTERNAL_URL=http://localhost:4001
REALTIME_INTERNAL_SECRET=   # shared secret between web app and realtime server
REALTIME_PORT=4001
WEB_APP_URL=http://localhost:3000

# Notifications (abstracted — plug in any provider)
EMAIL_PROVIDER_KEY=
OTP_PROVIDER_KEY=
